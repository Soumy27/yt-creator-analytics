# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- YouTube Data API v3 ---
# Get from: https://console.cloud.google.com/
#   1. Create a project
#   2. Enable "YouTube Data API v3"
#   3. Credentials -> Create Credentials -> API key
YOUTUBE_API_KEY=your_api_key_here

# Optional: add more keys separated by commas to multiply your daily quota.
# Each key must come from a SEPARATE Google Cloud project to get its own quota.
# Leave blank if you only have one key.
YOUTUBE_API_KEYS_EXTRA=

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=yt_analytics
PGUSER=postgres
PGPASSWORD=your_password_here

# --- Quota safety ---
# Stop the run when this many units have been spent today.
# Real ceiling is 10000; leaving headroom prevents a hard 403 mid-write.
QUOTA_DAILY_BUDGET=9000

# --- Collection behaviour ---
# Max videos to pull per channel during backfill (keeps the first run sane)
MAX_VIDEOS_PER_CHANNEL=500
# Only backfill videos published on/after this date (ISO). Blank = no limit.
BACKFILL_SINCE=2024-01-01
